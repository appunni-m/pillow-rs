 use std::path::PathBuf;
 use std::sync::{Mutex, OnceLock};
 
+// Temporary 4,097-call attribution probe; exclude the 4,096 setup call.
+// Aggregate once per public call, never per output row; then remove this block.
+#[derive(Clone, Copy, Default)]
+struct GetColorsPhaseProbeTotals {
+    calls: u64,
+    rows: u64,
+    core_ns: u64,
+    detach_map_error_ns: u64,
+    conversion_ns: u64,
+}
+
+static GETCOLORS_PHASE_PROBE: Mutex<GetColorsPhaseProbeTotals> =
+    Mutex::new(GetColorsPhaseProbeTotals {
+        calls: 0,
+        rows: 0,
+        core_ns: 0,
+        detach_map_error_ns: 0,
+        conversion_ns: 0,
+    });
+
+fn getcolors_probe_elapsed_ns(start: std::time::Instant) -> u64 {
+    u64::try_from(start.elapsed().as_nanos()).unwrap_or(u64::MAX)
+}
+
+fn record_getcolors_phase_probe(
+    core_ns: u64,
+    detach_map_error_ns: u64,
+    conversion_ns: u64,
+    rows: u64,
+) {
+    if let Ok(mut totals) = GETCOLORS_PHASE_PROBE.lock() {
+        totals.calls = totals.calls.saturating_add(1);
+        totals.rows = totals.rows.saturating_add(rows);
+        totals.core_ns = totals.core_ns.saturating_add(core_ns);
+        totals.detach_map_error_ns = totals
+            .detach_map_error_ns
+            .saturating_add(detach_map_error_ns);
+        totals.conversion_ns = totals.conversion_ns.saturating_add(conversion_ns);
+    }
+}
+
+#[pyfunction]
+fn _take_getcolors_phase_probe(py: Python<'_>) -> PyResult<Py<PyAny>> {
+    let mut totals = GETCOLORS_PHASE_PROBE
+        .lock()
+        .unwrap_or_else(|poisoned| poisoned.into_inner());
+    let snapshot = std::mem::take(&mut *totals);
+    drop(totals);
+
+    let result = PyDict::new(py);
+    result.set_item("calls", snapshot.calls)?;
+    result.set_item("rows", snapshot.rows)?;
+    result.set_item("core_ns", snapshot.core_ns)?;
+    result.set_item("detach_map_error_ns", snapshot.detach_map_error_ns)?;
+    result.set_item("conversion_ns", snapshot.conversion_ns)?;
+    Ok(result.into())
+}
+
 mod gpu_batch;
 mod putdata;
 
