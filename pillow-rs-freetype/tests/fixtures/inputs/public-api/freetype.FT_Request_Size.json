      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "size_metrics": [
            "x_ppem",
            "y_ppem",
            "x_scale",
            "y_scale",
            "ascender",
            "descender",
            "height",
            "max_advance"
          ]
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "outputs[*].status",
            "outputs[*].size_metrics"
          ]
        }
      }
