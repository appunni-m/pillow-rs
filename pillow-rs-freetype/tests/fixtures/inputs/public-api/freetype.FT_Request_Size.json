      "operation": "freetype.request_size",
      "schema": "size_metrics",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "requests": [
            {
              "type": "FT_SIZE_REQUEST_TYPE_NOMINAL",
              "width": 0,
              "height": 768,
              "horiResolution": 72,
              "vertResolution": 72
            },
            {
              "type": "FT_SIZE_REQUEST_TYPE_NOMINAL",
              "width": 640,
              "height": 768,
              "horiResolution": 96,
              "vertResolution": 72
            }
          ]
        }
