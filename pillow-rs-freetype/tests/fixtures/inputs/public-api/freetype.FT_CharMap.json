{
  "version": 1,
  "subject": "freetype.FT_CharMap",
  "manifest_cases": [
    "alias_defined",
    "owned_by_face_runtime"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_CharMap.alias_defined",
      "subject": "freetype.FT_CharMap",
      "case": "alias_defined",
      "operation": "abi_type_probe",
      "schema": "c_abi_type",
      "expect_error": false,
      "inputs": {
        "assets": {},
        "params": {
          "symbol": "FT_CharMap",
          "target": "struct FT_CharMapRec_*",
          "include": "<freetype/freetype.h>",
          "import": "#include <freetype/freetype.h>",
          "pointer_alias": true
        }
      },
      "classifiers": [
        "kind:type",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "symbol": "string",
          "target": "string",
          "pointer_alias": "bool",
          "pointer_width": "integer",
          "null_value": "zero",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "value",
          "paths": [
            "symbol",
            "target",
            "pointer_alias",
            "pointer_width",
            "null_value",
            "import_compiles"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/freetype.h"
        ]
      }
    },
    {
      "case_id": "freetype.FT_CharMap.owned_by_face_runtime",
      "subject": "freetype.FT_CharMap",
      "case": "owned_by_face_runtime",
      "operation": "freetype.charmap_ownership",
      "schema": "opaque_handle_runtime",
      "expect_error": false,
      "inputs": {
        "variants": [
          {
            "id": "dejavu_selectable_charmaps",
            "coverage": [
              "font:charmap-index-selectable-charmaps"
            ],
            "assets": {
              "font": {
                "kind": "file",
                "role": "font",
                "path": "input/fonts/DejaVuSans.ttf"
              }
            },
            "params": {
              "face_index": 0,
              "select_encodings": [
                "FT_ENCODING_UNICODE",
                "FT_ENCODING_MS_SYMBOL"
              ],
              "probe_chars": [
                65,
                32,
                61472
              ],
              "identity_policy": "compare face->charmaps entries by index/nullness, not raw process addresses"
            }
          },
          {
            "id": "no_parsed_charmaps",
            "coverage": [
              "font:charmap-index-no-active-charmap"
            ],
            "assets": {
              "font": {
                "kind": "ref",
                "role": "font",
                "path": "fonts/charmap/cmap-unsupported-only.ttf"
              }
            },
            "params": {
              "face_index": 0,
              "select_encodings": [],
              "probe_chars": [],
              "identity_policy": "compare null active charmap by index/nullness"
            }
          }
        ]
      },
      "classifiers": [
        "kind:type",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "status": "FT_Error",
          "num_charmaps": "integer",
          "active_charmap_index": "integer_or_null",
          "encoding": "FT_Encoding",
          "platform_id": "integer",
          "encoding_id": "integer",
          "char_indices": "array"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "num_charmaps",
            "charmaps[*].encoding",
            "charmaps[*].platform_id",
            "charmaps[*].encoding_id",
            "active_charmap_index",
            "char_indices"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/freetype.h",
          "freetype/src/base/ftobjs.c"
        ]
      }
    }
  ]
}
