      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "void",
          "done_hook": "class-specific hook invoked once",
          "free_events": "glyph allocation and owned payload released"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "rows[*].done_hook",
            "rows[*].free_events",
            "rows[*].sanitizer_classification"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/ftglyph.h",
          "freetype/src/base/ftglyph.c"
        ],
        "fixture_requirements": [
          "fonts/bitmap-strikes/public-bitmap-strike.ttf must contain at least one loadable embedded bitmap strike whose FT_GlyphSlot format becomes FT_GLYPH_FORMAT_BITMAP.",
          "fonts/svg/ot-svg-glyphs.ttf is optional and must contain a valid OT-SVG document for SVG rows; builds without FT_CONFIG_OPTION_SVG classify these rows as unsupported.",
          "facades/glyph/malformed-slot-and-class-cases.json must describe synthetic C harness cases for null slot/output, bad clazz, unsupported formats, oversized advances, and render/copy allocation failures."
        ]
      }
