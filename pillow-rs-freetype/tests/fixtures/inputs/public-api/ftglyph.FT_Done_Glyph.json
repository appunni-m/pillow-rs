            "outline",
            "bitmap",
            "svg_optional"
          ],
          "creation_paths": [
            "FT_Get_Glyph",
            "FT_Glyph_To_Bitmap"
          ],
          "destroy_order": "glyph_before_library"
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftglyph"
