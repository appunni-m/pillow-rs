{
  "version": 1,
  "subject": "freetype.FT_Select_Charmap",
  "manifest_cases": [
    "success_select_unicode_best",
    "success_select_present_encoding",
    "error_null_face",
    "error_missing_encoding"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_Select_Charmap.success_select_unicode_best",
      "subject": "freetype.FT_Select_Charmap",
      "case": "success_select_unicode_best",
      "operation": "freetype.select_charmap",
      "schema": "charmap",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "encoding": "FT_ENCODING_UNICODE",
          "post_probe_chars": [
            65,
            8364,
            128512
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "selected_charmap": [
            "encoding",
            "platform_id",
            "encoding_id",
            "format"
          ],
          "char_indices": "probe map"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "selected_charmap",
            "char_indices"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Select_Charmap.success_select_present_encoding",
      "subject": "freetype.FT_Select_Charmap",
      "case": "success_select_present_encoding",
      "operation": "freetype.select_charmap",
      "schema": "charmap",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/charmap/apple-roman-charmap.ttf",
            "status": "required_future_asset",
            "requires": "Font with a present non-Unicode Apple Roman charmap or BDF/PCF FT_ENCODING_NONE charmap"
          }
        },
        "params": {
          "face_index": 0,
          "encodings": [
            "FT_ENCODING_APPLE_ROMAN",
            "FT_ENCODING_NONE"
          ],
          "post_probe_chars": [
            65,
            196
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "selected_charmap": "metadata and char lookup"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "outputs[*].status",
            "outputs[*].selected_charmap",
            "outputs[*].char_indices"
          ]
        },
        "fixture_requirements": [
          "Non-Unicode or encoding-none charmap fixture"
        ]
      }
    },
    {
      "case_id": "freetype.FT_Select_Charmap.error_null_face",
      "subject": "freetype.FT_Select_Charmap",
      "case": "error_null_face",
      "operation": "freetype.select_charmap",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {},
        "params": {
          "face": "null",
          "encoding": "FT_ENCODING_UNICODE"
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "status",
            "error"
          ]
        },
        "error": "Invalid_Face_Handle"
      }
    },
    {
      "case_id": "freetype.FT_Select_Charmap.error_missing_encoding",
      "subject": "freetype.FT_Select_Charmap",
      "case": "error_missing_encoding",
      "operation": "freetype.select_charmap",
