{
  "version": 1,
  "subject": "freetype.FT_IS_FIXED_WIDTH",
  "manifest_cases": [
    "fixed_pitch_face_returns_true",
    "proportional_face_returns_false"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_IS_FIXED_WIDTH.fixed_pitch_face_returns_true",
      "subject": "freetype.FT_IS_FIXED_WIDTH",
      "case": "fixed_pitch_face_returns_true",
      "operation": "freetype.face_macro.is_fixed_width",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "fonts/metrics/fixed-width.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_FIXED_WIDTH",
          "post_probe": [
            "face.max_advance_width",
            "glyph advances"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_IS_FIXED_WIDTH",
          "expected_truth": true,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "monospace fixed-pitch face"
        ]
      }
    },
    {
      "case_id": "freetype.FT_IS_FIXED_WIDTH.proportional_face_returns_false",
      "subject": "freetype.FT_IS_FIXED_WIDTH",
      "case": "proportional_face_returns_false",
      "operation": "freetype.face_macro.is_fixed_width",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "input/fonts/LiberationSerif-Regular.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_FIXED_WIDTH",
          "post_probe": [
            "face.max_advance_width",
            "glyph advances"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_IS_FIXED_WIDTH",
          "expected_truth": false,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "proportional control face"
        ]
      }
    }
  ]
