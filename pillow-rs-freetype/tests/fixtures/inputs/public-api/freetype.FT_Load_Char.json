{
  "version": 1,
  "subject": "freetype.FT_Load_Char",
  "manifest_cases": [
    "default_load",
    "render_during_load",
    "matrix_load",
    "missing_char_loads_glyph_zero",
    "error_null_face_or_invalid_flags"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_Load_Char.default_load",
      "subject": "freetype.FT_Load_Char",
      "case": "default_load",
      "operation": "freetype.load_char",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "size": 20,
          "char_code": 65,
          "load_flags": [
            "FT_LOAD_DEFAULT"
          ],
          "select_charmap": "FT_ENCODING_UNICODE"
        },
        "variability": {
          "axes": [
            "fonts"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:glyph-load",
        "font_variability:input/fonts"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "slot": "FT_GlyphSlotRec outline metrics advance format"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "slot.metrics",
            "slot.advance",
            "slot.format",
            "slot.outline"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Load_Char.render_during_load",
      "subject": "freetype.FT_Load_Char",
      "case": "render_during_load",
      "operation": "freetype.load_char",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "size": 20,
          "char_code": 65,
          "load_flags": [
            "FT_LOAD_RENDER"
          ],
          "select_charmap": "FT_ENCODING_UNICODE"
        },
        "variability": {
          "axes": [
            "fonts"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:glyph-load",
        "font_variability:input/fonts"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "slot": "FT_GlyphSlotRec bitmap fields and bytes"
        },
        "compare": {
          "mode": "bytes",
          "paths": [
            "status",
            "slot.metrics",
            "slot.bitmap",
            "slot.bitmap_bytes"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Load_Char.matrix_load",
      "subject": "freetype.FT_Load_Char",
      "case": "matrix_load",
      "operation": "freetype.load_char",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font_folder": {
            "kind": "file",
            "role": "font_folder",
            "path": "input/fonts"
          }
        },
        "params": {
          "sizes": [
            10,
            20,
            32
          ],
          "char_codes": [
            0,
            32,
            65,
            8364,
            128512
          ],
          "load_flags": [
            0,
            4,
            2,
            8,
            16,
            32,
            64
          ],
          "target_modes": [
            "NORMAL",
            "LIGHT",
            "MONO",
            "LCD",
            "LCD_V"
          ]
        },
        "variability": {
          "axes": [
            "fonts",
            "sizes",
            "codepoints",
            "load_flags"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:glyph-load",
        "font_variability:input/fonts"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "rows": "per-font load status and slot snapshot"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "rows[].status",
            "rows[].slot"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Load_Char.missing_char_loads_glyph_zero",
      "subject": "freetype.FT_Load_Char",
      "case": "missing_char_loads_glyph_zero",
      "operation": "freetype.load_char",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "size": 20,
          "char_codes": [
            1114111,
            4294967295
          ],
          "load_flags": [
            "FT_LOAD_DEFAULT",
            "FT_LOAD_RENDER"
          ],
          "selected_charmap": "FT_ENCODING_UNICODE"
        },
        "variability": {
          "axes": [
            "codepoints"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:glyph-load"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "slot": "glyph zero load snapshot"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "slot.glyph_index",
            "slot.metrics",
            "slot.format",
            "slot.bitmap"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Load_Char.error_null_face_or_invalid_flags",
      "subject": "freetype.FT_Load_Char",
      "case": "error_null_face_or_invalid_flags",
      "operation": "freetype.load_char",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "variants": [
            {
              "face": "null",
              "char_code": 65,
              "load_flags": [
                "FT_LOAD_DEFAULT"
              ]
            },
            {
              "face_index": 0,
              "char_code": 65,
              "load_flags": [
                "reserved_high_bits",
                "FT_LOAD_SBITS_ONLY_without_strike_if_errors"
              ]
            }
          ],
          "size": 20
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:glyph-load"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "slot_mutation": "c_oracle"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "status",
            "error",
            "slot_snapshot"
          ]
        },
        "error": "c_oracle"
      }
    }
  ]
}
