{
  "version": 1,
  "subject": "freetype.FT_Attach_Stream",
  "manifest_cases": [
    "success_attach_auxiliary_stream",
    "error_null_face",
    "error_null_open_args",
    "error_invalid_open_args_or_unsupported_driver"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_Attach_Stream.success_attach_auxiliary_stream",
      "subject": "freetype.FT_Attach_Stream",
      "case": "success_attach_auxiliary_stream",
      "operation": "freetype.attach_stream",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/type1/attach-afm-base.pfb"
          },
          "attachment": {
            "kind": "ref",
            "role": "auxiliary_metrics_stream",
            "path": "input/aux/type1/attach-afm-base.afm",
            "status": "required_future_asset",
            "requires": "In-memory AFM/PFM bytes accepted by Type1 attach_file hook"
          }
        },
        "params": {
          "face_index": 0,
          "open_args": {
            "flags": [
              "FT_OPEN_MEMORY"
            ],
            "memory_base": "attachment",
            "memory_size": "asset_length"
          },
          "post_attach_probe": [
            "FT_Get_Kerning",
            "glyph_metrics"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:attachment"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "post_attach_probe": "face_state_delta"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "post_attach_probe"
          ]
        },
        "fixture_requirements": [
          "Type1 PFB plus matching AFM/PFM bytes fixture"
        ]
      }
    },
    {
