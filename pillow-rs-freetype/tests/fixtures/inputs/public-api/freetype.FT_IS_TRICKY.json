{
  "version": 1,
  "subject": "freetype.FT_IS_TRICKY",
  "manifest_cases": [
    "tricky_font_returns_true",
    "ordinary_font_returns_false"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_IS_TRICKY.tricky_font_returns_true",
      "subject": "freetype.FT_IS_TRICKY",
      "case": "tricky_font_returns_true",
      "operation": "freetype.face_macro.is_tricky",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "fonts/tricky/mingli-compatible.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_TRICKY",
          "post_probe": [
            "FT_Load_Glyph with FT_LOAD_FORCE_AUTOHINT and FT_LOAD_NO_HINTING"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_IS_TRICKY",
          "expected_truth": true,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "font classified by pinned FreeType ttobjs.c tricky-font list"
        ]
      }
    },
    {
      "case_id": "freetype.FT_IS_TRICKY.ordinary_font_returns_false",
      "subject": "freetype.FT_IS_TRICKY",
      "case": "ordinary_font_returns_false",
      "operation": "freetype.face_macro.is_tricky",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "input/fonts/LiberationSerif-Regular.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_TRICKY",
          "post_probe": [
            "FT_Load_Glyph with FT_LOAD_FORCE_AUTOHINT and FT_LOAD_NO_HINTING"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_IS_TRICKY",
          "expected_truth": false,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "ordinary TrueType control font"
        ]
      }
    }
  ]
}
