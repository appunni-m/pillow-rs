{
  "version": 1,
  "subject": "freetype.FT_New_Memory_Face",
  "manifest_cases": [
    "valid_font_bytes",
    "success_negative_face_index_probe",
    "success_named_instance_index",
    "error_null_file_base",
    "error_null_library_or_aface",
    "error_bad_size_or_unknown_format"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_New_Memory_Face.valid_font_bytes",
      "subject": "freetype.FT_New_Memory_Face",
      "case": "valid_font_bytes",
      "operation": "new_memory_face",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font_bytes": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "memory_source": "whole_file",
          "post_open_probes": [
            "face_fields",
            "glyph_slot",
            "active_size",
            "selected_charmap"
          ]
        },
        "variability": {
          "axes": [
            "fonts"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "face": "created_from_memory",
          "face_state": [
            "num_faces",
            "family_name",
            "style_name",
            "face_flags",
            "num_glyphs",
            "charmap_encoding"
          ]
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "face_state"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_New_Memory_Face.success_negative_face_index_probe",
      "subject": "freetype.FT_New_Memory_Face",
      "case": "success_negative_face_index_probe",
      "operation": "new_memory_face",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font_bytes": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": -1,
          "memory_source": "whole_file"
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "probe_fields": [
            "num_faces",
            "style_flags_named_instance_count"
          ]
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "probe_fields"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_New_Memory_Face.success_named_instance_index",
      "subject": "freetype.FT_New_Memory_Face",
      "case": "success_named_instance_index",
      "operation": "new_memory_face",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font_bytes": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/variable/named-instances.ttf",
            "status": "required_future_asset",
            "requires": "Variable font with at least one named instance"
          }
        },
        "params": {
          "face_index": "0 | (1 << 16)",
          "memory_source": "whole_file"
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "variation_state": [
            "face_index",
            "style_flags",
            "face_flags",
            "named_instance_coords"
          ]
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "variation_state"
          ]
        },
        "fixture_requirements": [
          "Variable font with named instance bits observable in style flags and coordinates"
        ]
      }
    },
    {
      "case_id": "freetype.FT_New_Memory_Face.error_null_file_base",
      "subject": "freetype.FT_New_Memory_Face",
      "case": "error_null_file_base",
