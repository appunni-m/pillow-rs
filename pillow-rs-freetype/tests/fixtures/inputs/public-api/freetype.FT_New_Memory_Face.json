    {
      "case_id": "freetype.FT_New_Memory_Face.error_bad_size_or_unknown_format",
      "subject": "freetype.FT_New_Memory_Face",
      "case": "error_bad_size_or_unknown_format",
      "operation": "new_memory_face",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {
          "malformed": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/malformed/not-a-font.bin",
            "status": "required_future_asset",
            "requires": "Small deterministic malformed byte blob rejected by C FreeType"
          },
          "font_bytes": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "variants": [
            {
              "file_size": -1
            },
            {
              "file_size": 0
            },
            {
              "file_size": 12
            },
            {
              "source": "malformed"
            },
            {
              "face_index": 9999
            }
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "face": "not_created"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "outputs[*].status",
            "outputs[*].error",
            "outputs[*].face_nullness"
          ]
