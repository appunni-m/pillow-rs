      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "aface": "unchanged"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "status",
            "error",
            "aface_nullness"
          ]
        },
        "error": "Invalid_Argument"
      }
    },
    {
      "case_id": "freetype.FT_New_Memory_Face.error_null_library_or_aface",
