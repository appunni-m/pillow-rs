            "pos": 0,
            "descriptor.pointer": "callback_harness",
            "pathname.pointer": null,
            "read": "callback_harness.read",
            "close": "callback_harness.close"
          },
          "read_callback_cases": [
            {"offset": 0, "count": 0, "meaning": "seek_status"},
            {"offset": 0, "count": 4, "meaning": "read_bytes"},
            {"offset": "past_end", "count": 8, "meaning": "short_read_or_error"}
          ]
        }
