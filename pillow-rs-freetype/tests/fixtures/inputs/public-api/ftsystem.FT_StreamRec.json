        "compare": {
          "mode": "exact",
          "paths": ["face_load_status", "stream_after", "callback_events", "close_called_by_face_done"]
        },
        "fixture_requirements": ["Add a reusable external stream callback harness that records read(count==0), read(count>0), and close events without embedding font bytes in JSON."]
