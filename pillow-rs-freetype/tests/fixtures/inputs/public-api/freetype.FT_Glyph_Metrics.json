      "case_id": "freetype.FT_Glyph_Metrics.loaded_glyph_metrics_match_c",
      "subject": "freetype.FT_Glyph_Metrics",
      "case": "loaded_glyph_metrics_match_c",
      "operation": "freetype.inspect_glyph_metrics",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "input/fonts/LiberationSerif-Regular.ttf"
          },
          "vertical_font": {
            "kind": "ref",
            "id": "fonts/vertical/cjk-vertical-metrics.ttf"
          }
        },
        "params": {
          "sizes": [
            12,
            20,
            48
          ],
          "glyph_indices": [
            "A",
            "space",
            "accented",
            "vertical_representative"
          ],
          "load_flags": [
            "FT_LOAD_DEFAULT",
            "FT_LOAD_NO_HINTING",
            "FT_LOAD_NO_SCALE",
            "FT_LOAD_VERTICAL_LAYOUT"
          ],
          "probe": [
            "face.glyph.metrics"
          ]
        }
      },
      "classifiers": [
        "kind:record",
