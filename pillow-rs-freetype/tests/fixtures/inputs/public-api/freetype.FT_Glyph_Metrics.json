        "compare": {
          "mode": "exact",
          "paths": [
            "metrics.width",
            "metrics.height",
            "metrics.horiBearingX",
            "metrics.horiBearingY",
            "metrics.horiAdvance",
            "metrics.vertBearingX",
            "metrics.vertBearingY",
            "metrics.vertAdvance",
            "status"
          ]
        },
        "fixture_requirements": [
