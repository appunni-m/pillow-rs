    {
      "case_id": "ftcolor.FT_PaintSolid.get_paint_solid_values",
      "subject": "ftcolor.FT_PaintSolid",
      "case": "get_paint_solid_values",
      "operation": "ftcolor.get_color_glyph_paint_and_get_paint",
      "schema": "paint_graph",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "id": "fonts/color/colr-v1-solid-palette.ttf",
            "asset_kind": "font"
          }
        },
        "params": {
          "face_index": 0,
          "base_glyph": "paint_solid_palette_matrix",
          "root_transform_modes": [
            "FT_COLOR_NO_ROOT_TRANSFORM",
            "FT_COLOR_INCLUDE_ROOT_TRANSFORM"
          ],
          "traversal": "FT_Get_Color_Glyph_Paint then recursive FT_Get_Paint",
          "expected_format": "FT_COLR_PAINTFORMAT_SOLID",
          "active_union_member": "solid",
          "variation_coords": [
            "default",
            "minmax if fixture is variable"
          ],
          "read_colorline_stops": "when record contains FT_ColorLine",
          "malformed_controls": "separate malformed COLR fixture may assert false status/output preservation"
        }
      },
      "classifiers": [
        "kind:record",
        "header:ftcolor",
        "area:colr-v1",
        "requires:font",
        "path:runtime"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "status": "FT_Bool",
          "paint": {
            "format": "FT_COLR_PAINTFORMAT_SOLID",
            "solid": {
              "color": "C oracle value or identity class"
            }
          },
          "children": "opaque child paint identity classes when present",
          "color_stops": "FT_ColorStop sequence when present"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "paint.format",
            "paint.u.solid",
            "child_paint_identity_classes",
            "color_stop_iterator",
            "variation_interpolation",
            "root_transform_mode"
          ]
        },
        "fixture_requirements": [
          "COLR v1 font with PaintSolid nodes for palette index 0, last valid palette index, foreground index 0xFFFF, alpha 0, fractional alpha, and alpha 1.0, backed by a CPAL table with at least two palettes."
        ]
      }
    }
