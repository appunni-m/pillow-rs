            {"id": "cid_supported", "asset": "cid_font", "face_index": 0, "output_pointer_mode": "valid"},
            {"id": "type42_supported", "asset": "type42_font", "face_index": 0, "output_pointer_mode": "valid"},
            {"id": "non_postscript_invalid_argument", "asset": "truetype_font", "face_index": 0, "output_pointer_mode": "valid", "expected_error": "FT_Err_Invalid_Argument"},
            {"id": "null_face", "face_pointer_mode": "null", "output_pointer_mode": "valid", "expected_error": "FT_Err_Invalid_Face_Handle"},
            {"id": "null_output", "asset": "type1_font", "face_index": 0, "output_pointer_mode": "null", "expected_error": "FT_Err_Invalid_Argument"}
          ]
        }
      },
      "classifiers": ["kind:function", "header:t1tables", "area:ps_font_info", "requires:future_asset"],
      "expectation": {
        "status": "build_dependent",
        "fixture_requirements": "Needs Type 1, CFF, CFF2, CID Type 1, Type 42, and non-PostScript control faces for the full matrix.",
        "output_shape": {"status": "FT_Error", "font_info": {"version": "nullable FT_String*", "notice": "nullable FT_String*", "full_name": "nullable FT_String*", "family_name": "nullable FT_String*", "weight": "nullable FT_String*", "italic_angle": "FT_Fixed", "is_fixed_pitch": "FT_Bool", "underline_position": "FT_Short", "underline_thickness": "FT_UShort"}},
