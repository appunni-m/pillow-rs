            "assets": {
              "font": {
                "kind": "ref",
                "role": "font",
                "id": "fixtures/assets/fonts/sbit_gray_format1.ttf"
              }
            },
            "params": {
              "face_index": 0,
              "strike_index": 0
            },
            "coverage": [
              "freetype.select_size:explicit-f1"
            ]
          }
        ]
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "selected_size_metrics": "FT_Size_Metrics"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "outputs[*].status",
            "outputs[*].selected_size_metrics"
          ]
        },
        "fixture_requirements": [
          "Compact EBLC/EBDT fixture with one fixed strike"
        ]
      }
    },
    {
      "case_id": "freetype.FT_Select_Size.error_no_fixed_sizes_or_null_face",
      "subject": "freetype.FT_Select_Size",
      "case": "error_no_fixed_sizes_or_null_face",
      "operation": "freetype.select_size",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "variants": [
          {
            "id": "null-face",
            "params": {
              "face": "null",
              "strike_index": 0
            },
            "coverage": [
              "freetype.select_size:null-face-error"
            ]
          },
          {
            "id": "no-fixed-sizes",
            "assets": {
              "font": {
                "kind": "file",
                "role": "font",
                "path": "input/fonts/DejaVuSans.ttf"
              }
            },
            "params": {
              "strike_index": 0
            },
            "coverage": [
              "freetype.select_size:no-fixed-size-error"
            ]
          }
        ]
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "outputs[*].status",
            "outputs[*].error"
          ]
        },
        "error": "Invalid_Face_Handle"
      }
    },
    {
      "case_id": "freetype.FT_Select_Size.error_strike_index_out_of_range",
      "subject": "freetype.FT_Select_Size",
      "case": "error_strike_index_out_of_range",
      "operation": "freetype.select_size",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "id": "fixtures/assets/fonts/sbit_gray_format1.ttf"
          }
        },
        "params": {
          "variants": [
            {
              "id": "negative",
              "face_index": 0,
              "strike_index": -1
            },
            {
              "id": "past_end",
              "face_index": 0,
              "strike_index": 1
            }
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "active_size_after_error": "unchanged"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "outputs[*].status",
            "outputs[*].error",
            "outputs[*].size_snapshot_before_after"
          ]
        },
        "error": "Invalid_Argument"
      }
    },
    {
