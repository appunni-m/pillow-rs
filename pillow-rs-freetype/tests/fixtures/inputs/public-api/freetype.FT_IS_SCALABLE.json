{
  "version": 1,
  "subject": "freetype.FT_IS_SCALABLE",
  "manifest_cases": [
    "scalable_outline_face_returns_true",
    "bitmap_only_face_returns_false"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_IS_SCALABLE.scalable_outline_face_returns_true",
      "subject": "freetype.FT_IS_SCALABLE",
      "case": "scalable_outline_face_returns_true",
      "operation": "freetype.face_macro.is_scalable",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "input/fonts/LiberationSerif-Regular.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_SCALABLE",
          "post_probe": [
            "face.units_per_EM",
            "face.bbox",
            "available_sizes"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_IS_SCALABLE",
          "expected_truth": true,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "scalable outline font"
        ]
      }
    },
    {
      "case_id": "freetype.FT_IS_SCALABLE.bitmap_only_face_returns_false",
