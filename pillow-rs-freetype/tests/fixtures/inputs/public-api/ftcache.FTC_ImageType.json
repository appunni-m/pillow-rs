        "header:ftcache",
        "area:image-cache"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "ownership": "caller_owned_descriptor",
          "cache_query": "fields read during lookup only"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
