{
  "version": 1,
  "subject": "freetype.FT_Reference_Face",
  "manifest_cases": [
    "success_increments_refcount",
    "success_multiple_references",
    "error_null_face"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_Reference_Face.success_increments_refcount",
      "subject": "freetype.FT_Reference_Face",
      "case": "success_increments_refcount",
      "operation": "freetype.reference_face",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "sequence": [
            "open_face",
            "reference_face",
            "done_face",
            "probe_face",
            "done_face"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "lifetime": "one_extra_done_required",
          "face_state_after_first_done": "still_valid"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "face_state_after_first_done",
            "final_done_status"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Reference_Face.success_multiple_references",
      "subject": "freetype.FT_Reference_Face",
      "case": "success_multiple_references",
      "operation": "freetype.reference_face",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "reference_count": 3,
          "probe_after_each_done": [
            "family_name",
            "num_glyphs"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "lifetime": "matching_done_calls"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "outputs[*].reference_status",
            "outputs[*].done_status",
            "outputs[*].probe_state"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Reference_Face.error_null_face",
      "subject": "freetype.FT_Reference_Face",
      "case": "error_null_face",
      "operation": "freetype.reference_face",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {},
        "params": {
          "face": "null"
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "status",
            "error"
          ]
        },
        "error": "Invalid_Face_Handle"
      }
    }
  ]
}
