      "operation": "ftcache.manager_lookup_size",
      "schema": "cache_operation",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "fonts/basic/dejavu-sans.ttf",
            "asset_kind": "font"
          },
          "alt_font": {
            "kind": "ref",
            "id": "fonts/basic/dejavu-serif.ttf",
            "asset_kind": "font"
          },
          "multi_charmap_font": {
            "kind": "ref",
            "id": "fonts/charmap/multiple-charmaps.ttf",
            "asset_kind": "font"
          }
        },
        "params": {
          "manager_limits": {
            "max_faces": 0,
            "max_sizes": 0,
            "max_bytes": 0
          },
          "face_ids": [
            "face-A",
            "face-B"
          ],
          "requester": "path_face_requester_with_log",
          "scenario": "planned_cache_subsystem_not_out_of_scope",
          "scalers": [
            {
              "pixel": 1,
              "width": 9,
              "height": 20
            },
            {
              "pixel": 0,
              "width": 768,
              "height": 1024,
              "x_res": 72,
              "y_res": 96
            },
            {
              "pixel": 1,
              "width": 0,
              "height": 0
            }
          ],
          "repeat_lookup": true
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftcache",
        "area:cache-subsystem"
      ],
      "expectation": {
        "status": "build_dependent",
        "output_shape": {
          "return": "FT_Error",
          "callback_log": true,
          "pointer_identity_classes": true,
          "cache_lifecycle": true,
          "size_metrics": [
            "x_ppem",
            "y_ppem",
            "x_scale",
            "y_scale",
            "ascender",
            "descender",
            "height",
            "max_advance"
          ],
          "parent_face_identity": true
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "error",
            "outputs",
            "callback_log",
            "pointer_identity_classes",
            "lifecycle_events"
          ]
