  "cases": [
    {
      "case_id": "ftgzip.FT_Gzip_Uncompress.uncompresses_valid_gzip_buffer",
      "subject": "ftgzip.FT_Gzip_Uncompress",
      "case": "uncompresses_valid_gzip_buffer",
      "operation": "ftgzip.gzip_uncompress",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "gzip_payloads": {
            "kind": "ref",
            "id": "compressed/gzip/small-text-and-empty-payloads.json"
          }
        },
        "params": {
          "memory": "library_memory",
          "output_buffer_sizes": [
            "exact_uncompressed_size",
            "larger_than_uncompressed_size"
          ],
          "input_kinds": [
            "gzip",
            "zlib_wrapped"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftgzip"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "status": "FT_Error",
          "output_len_after_call": "FT_ULong",
          "output_bytes": "prefix of caller output buffer"
        },
        "compare": {
          "mode": "bytes",
          "paths": [
            "rows[*].status",
            "rows[*].output_len",
            "rows[*].output_bytes"
          ]
        },
        "fixture_requirements": [
          "compressed/gzip/small-text-and-empty-payloads.json must reference gzip and zlib-wrapped byte fixtures, not embed generated oracle outputs"
        ],
        "source_refs": [
          "freetype/include/freetype/ftgzip.h:98-137",
          "freetype/src/gzip/ftgzip.c:711-771"
        ]
      }
    },
