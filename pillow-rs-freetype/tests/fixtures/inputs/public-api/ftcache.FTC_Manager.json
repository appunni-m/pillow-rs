{
  "version": 1,
  "subject": "ftcache.FTC_Manager",
  "manifest_cases": [
    "alias_defined",
    "owns_faces_sizes_and_cache_nodes",
    "reset_and_done_lifecycle"
  ],
  "cases": [
    {
      "case_id": "ftcache.FTC_Manager.alias_defined",
      "subject": "ftcache.FTC_Manager",
      "case": "alias_defined",
      "operation": "abi_type_probe",
      "schema": "abi_type",
      "expect_error": false,
      "inputs": {
        "assets": {},
        "params": {
          "include": "<freetype/ftcache.h>",
          "typedef": "FTC_Manager",
          "expected_alias": "struct FTC_ManagerRec_*"
        }
      },
      "classifiers": [
        "kind:type",
        "header:ftcache",
        "area:cache-manager"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "type": "opaque_pointer_alias",
          "sizeof": "pointer_size"
        },
        "compare": {
          "mode": "layout",
          "paths": [
            "sizeof",
            "alignment",
            "is_pointer",
            "compile_probe"
          ]
        }
      }
    },
    {
      "case_id": "ftcache.FTC_Manager.owns_faces_sizes_and_cache_nodes",
      "subject": "ftcache.FTC_Manager",
      "case": "owns_faces_sizes_and_cache_nodes",
      "operation": "ftcache.manager_ownership",
      "schema": "cache_lifecycle",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "scalable_control_font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "manager_limits": {
            "max_faces": 1,
            "max_sizes": 1,
            "max_bytes": 4096
          },
          "create": [
            "FTC_Manager_New",
            "FTC_SBitCache_New"
          ],
          "populate": [
            "FTC_Manager_LookupFace",
            "FTC_Manager_LookupSize",
            "FTC_SBitCache_Lookup"
          ],
          "requester": "counting_memory_face_requester"
        }
      },
      "classifiers": [
        "kind:type",
        "header:ftcache",
        "area:cache-manager"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "owned_objects": [
            "FT_Face",
            "FT_Size",
            "FTC_Node"
          ],
          "ownership_observation": "finalizer_counts_and_identity_classes"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "requester_calls",
            "face_finalizer_counts",
            "size_identity_classes",
            "node_identity_classes"
          ]
        },
        "fixture_requirements": [
          "Runner support for face generic finalizer/counter observation"
        ]
      }
    },
    {
      "case_id": "ftcache.FTC_Manager.reset_and_done_lifecycle",
      "subject": "ftcache.FTC_Manager",
      "case": "reset_and_done_lifecycle",
      "operation": "ftcache.manager_lifecycle",
      "schema": "cache_lifecycle",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "scalable_control_font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "sequence": [
            "FTC_Manager_New",
            "populate_cache",
            "FTC_Manager_Reset",
            "post_reset_lookup",
            "FTC_Manager_Done"
          ],
          "post_done_use": "not_executed"
        }
      },
      "classifiers": [
        "kind:type",
        "header:ftcache",
        "area:cache-manager"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "reset": "empties_but_manager_usable",
          "done": "destroys_manager_and_caches"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "reset.status",
            "post_reset_lookup.status",
            "done.finalizer_counts",
            "done.cache_handle_lifecycle"
          ]
        }
      }
    }
  ]
}
