        "params": {
          "face_index": 0,
          "palette_indices": [
            0,
            1
          ],
          "entries": [
            0,
            1,
            "last"
          ]
        }
      },
      "classifiers": [
        "kind:record",
        "header:ftcolor",
        "area:colr-v1",
        "path:runtime"
