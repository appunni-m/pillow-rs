{
  "version": 1,
  "subject": "freetype.FT_Load_Glyph",
  "manifest_cases": [
    "default_load",
    "matrix_load",
    "render_and_target_modes",
    "no_scale_no_hinting_and_vertical_flags",
    "error_out_of_range_null_face_or_invalid_flags"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_Load_Glyph.default_load",
      "subject": "freetype.FT_Load_Glyph",
      "case": "default_load",
      "operation": "freetype.load_glyph",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "size": 20,
          "glyph_index": 36,
          "load_flags": [
            "FT_LOAD_DEFAULT"
          ]
        },
        "variability": {
          "axes": [
            "fonts"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:glyph-load",
        "font_variability:input/fonts"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "slot": "FT_GlyphSlotRec outline metrics advance format"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "slot.metrics",
            "slot.advance",
            "slot.format",
            "slot.outline"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Load_Glyph.matrix_load",
      "subject": "freetype.FT_Load_Glyph",
      "case": "matrix_load",
      "operation": "freetype.load_glyph",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
