{
  "version": 1,
  "subject": "freetype.FT_Get_Postscript_Name",
  "manifest_cases": [
    "static_face_name_success",
    "variation_instance_name_behavior",
    "unavailable_or_null_face_returns_null"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_Get_Postscript_Name.static_face_name_success",
      "subject": "freetype.FT_Get_Postscript_Name",
      "case": "static_face_name_success",
      "operation": "freetype.get_postscript_name",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/names/postscript-name.ttf",
            "status": "required_future_asset",
            "requires": "font with deterministic PostScript name exposed through POSTSCRIPT_FONT_NAME service"
          }
        },
        "params": {
          "face_index": 0,
          "lifetime_probe": "before_done_face"
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:names"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "nullable_const_char_ptr",
          "bytes": "ASCII PostScript name",
          "ownership": "face_borrowed"
        },
        "compare": {
          "mode": "bytes",
          "paths": [
            "nullness",
            "bytes"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Get_Postscript_Name.variation_instance_name_behavior",
      "subject": "freetype.FT_Get_Postscript_Name",
      "case": "variation_instance_name_behavior",
      "operation": "freetype.get_postscript_name",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/variable/named-instance-postscript.ttf",
            "status": "required_future_asset",
            "requires": "variable font whose named instance changes the PostScript name through FT_Set_Named_Instance"
          }
        },
        "params": {
          "face_index": 0,
          "named_instances": [
            "default",
            1,
            2
          ],
          "call_sequence": [
            "FT_Set_Named_Instance",
            "FT_Get_Postscript_Name"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:names",
        "font_variability:variable"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "nullable_const_char_ptr",
          "bytes_by_instance": "ASCII or null"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "instance_results"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Get_Postscript_Name.unavailable_or_null_face_returns_null",
      "subject": "freetype.FT_Get_Postscript_Name",
      "case": "unavailable_or_null_face_returns_null",
      "operation": "freetype.get_postscript_name",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font_without_name": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/names/no-postscript-name.ttf",
            "status": "required_future_asset",
            "requires": "accepted font where POSTSCRIPT_FONT_NAME service returns null"
          }
        },
        "params": {
          "face_variants": [
            "null",
            "live_without_postscript_name"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:names"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "nullable_const_char_ptr"
        },
        "compare": {
          "mode": "nullness",
          "paths": [
            "nullness"
          ]
        }
      }
    }
  ]
}
