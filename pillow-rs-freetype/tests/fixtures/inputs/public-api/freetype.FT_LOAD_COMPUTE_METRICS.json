{
  "version": 1,
  "subject": "freetype.FT_LOAD_COMPUTE_METRICS",
  "manifest_cases": [
    "value_matches_header",
    "compute_metrics_load_behavior"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_LOAD_COMPUTE_METRICS.value_matches_header",
      "subject": "freetype.FT_LOAD_COMPUTE_METRICS",
      "case": "value_matches_header",
      "operation": "constant",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {},
        "params": {
          "symbol": "FT_LOAD_COMPUTE_METRICS",
          "include": "<freetype/freetype.h>",
          "header": "freetype/freetype.h",
          "probe": "compile_and_eval_integer_macro"
        }
      },
      "classifiers": [
        "kind:flag",
        "header:freetype",
        "surface:public-c-api",
        "coverage:value-import"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "symbol": "string",
          "value": "integer",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "value",
          "paths": [
            "symbol",
            "value",
            "import_compiles"
          ]
        },
        "oracle": "generated_at_runtime_from_c_freetype",
        "sources_checked": [
          "freetype/include/freetype/freetype.h"
        ]
      }
    },
    {
      "case_id": "freetype.FT_LOAD_COMPUTE_METRICS.compute_metrics_load_behavior",
      "subject": "freetype.FT_LOAD_COMPUTE_METRICS",
      "case": "compute_metrics_load_behavior",
      "operation": "load_glyph",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "variants": [
          {
            "id": "normal-backward-compatible",
            "assets": {
              "font": { "kind": "ref", "id": "fonts/metrics/hdmx_observable.ttf" }
            },
            "params": {
              "face_index": 0,
              "pixel_size": 20,
              "load_flags": ["FT_LOAD_DEFAULT"],
              "glyph_index": { "from_char_code": 65 },
              "assert_api_load_glyph_agrees": true
            },
            "coverage": ["tt/hdmx:backward-compatibility-suppresses-device-width"]
          },
          {
            "id": "compute-metrics",
            "assets": {
              "font": { "kind": "ref", "id": "fonts/metrics/hdmx_observable.ttf" }
            },
            "params": {
              "face_index": 0,
              "pixel_size": 20,
              "load_flags": ["FT_LOAD_COMPUTE_METRICS"],
              "glyph_index": { "from_char_code": 65 },
              "assert_api_load_glyph_agrees": true
            },
            "coverage": ["tt/hdmx:compute-metrics-suppresses-device-width"]
          },
          {
            "id": "mono-device-width",
            "assets": {
              "font": { "kind": "ref", "id": "fonts/metrics/hdmx_observable.ttf" }
            },
            "params": {
              "face_index": 0,
              "pixel_size": 20,
              "load_flags": ["FT_LOAD_TARGET_MONO"],
              "glyph_index": { "from_char_code": 65 }
            },
            "coverage": ["tt/hdmx:mono-device-width-lookup"]
          },
          {
            "id": "mono-compute-metrics",
            "assets": {
              "font": { "kind": "ref", "id": "fonts/metrics/hdmx_observable.ttf" }
            },
            "params": {
              "face_index": 0,
              "pixel_size": 20,
              "load_flags": ["FT_LOAD_TARGET_MONO", "FT_LOAD_COMPUTE_METRICS"],
              "glyph_index": { "from_char_code": 65 }
            },
            "coverage": ["tt/hdmx:mono-compute-metrics-suppression"]
          },
          {
            "id": "mono-ppem-outside-hdmx-u8",
            "assets": {
              "font": { "kind": "ref", "id": "fonts/metrics/hdmx_observable.ttf" }
            },
            "params": {
              "face_index": 0,
              "pixel_size": 256,
              "load_flags": ["FT_LOAD_TARGET_MONO"],
              "glyph_index": { "from_char_code": 65 }
            },
            "coverage": ["tt/hdmx:ppem-outside-u8-range"]
          },
          {
            "id": "mono-ppem-record-miss",
            "assets": {
              "font": { "kind": "ref", "id": "fonts/metrics/hdmx_observable.ttf" }
            },
            "params": {
              "face_index": 0,
              "pixel_size": 19,
              "load_flags": ["FT_LOAD_TARGET_MONO"],
              "glyph_index": { "from_char_code": 65 }
            },
            "coverage": ["tt/hdmx:representable-ppem-record-miss"]
          }
        ]
      },
      "classifiers": [
        "kind:flag",
        "header:freetype",
        "operation:load",
        "coverage:runtime-observable"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "error": "FT_Error",
          "glyph_slot": {
            "format": "FT_Glyph_Format",
            "metrics": "FT_Glyph_Metrics",
            "advance": "FT_Vector",
            "linearHoriAdvance": "FT_Fixed",
            "linearVertAdvance": "FT_Fixed",
            "bitmap": "FT_Bitmap summary and bytes when rendered",
            "outline": "point/contour/tag vectors when exposed",
            "subglyphs": "subglyph metadata when non-recursive composite load is requested"
          }
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "error",
            "glyph_slot.metrics",
            "glyph_slot.advance",
            "glyph_slot.linearHoriAdvance",
            "glyph_slot.linearVertAdvance"
          ]
        },
        "oracle": "generated_at_runtime_from_c_freetype",
        "sources_checked": [
          "freetype/include/freetype/freetype.h",
          "freetype/src/base/ftobjs.c",
          "freetype/src/truetype/ttgload.c"
        ],
        "fixture_requirements": "Needs a TrueType fixture with hdmx or bundled metrics whose default path differs from computed glyph metrics at pixel_size 20."
      }
    }
  ]
}
