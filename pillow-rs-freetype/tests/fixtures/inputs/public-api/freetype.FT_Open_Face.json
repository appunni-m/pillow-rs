      "subject": "freetype.FT_Open_Face",
      "case": "success_open_memory",
      "operation": "freetype.open_face",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font_bytes": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "open_args": {
            "flags": [
              "FT_OPEN_MEMORY"
            ]
          },
          "face_index": 0
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "face_state": [
            "metadata",
            "glyph_slot_present",
            "size_present",
            "selected_charmap"
          ]
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "face_state"
          ]
        }
      }
    },
