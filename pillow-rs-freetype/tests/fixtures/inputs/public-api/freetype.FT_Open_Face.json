      "case_id": "freetype.FT_Open_Face.error_invalid_source_flags",
      "subject": "freetype.FT_Open_Face",
      "case": "error_invalid_source_flags",
      "operation": "freetype.open_face",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "variants": [
            {
              "flags": []
            },
            {
              "flags": [
                "FT_OPEN_MEMORY",
                "FT_OPEN_PATHNAME"
              ]
            },
            {
              "flags": [
                "FT_OPEN_STREAM"
              ],
              "stream": "failing_external_stream"
            }
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "stream_close_callback": "called_for_external_stream_on_error"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "outputs[*].status",
            "outputs[*].error",
            "outputs[*].stream_close_count"
          ]
        },
        "error": "c_oracle",
        "fixture_requirements": [
          "Runner support for synthetic external FT_Stream close callback"
        ]
      }
    },
