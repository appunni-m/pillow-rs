      "case": "success_large_dimension_clamp",
      "operation": "freetype.set_pixel_sizes",
      "schema": "size_metrics",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "sizes": [
            [
              65535,
              65535
            ],
            [
              70000,
              20
            ],
            [
              20,
              70000
            ]
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "clamped_request": "0xFFFF before 26.6 conversion or C oracle error if metrics overflow"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "outputs[*].status",
            "outputs[*].error",
            "outputs[*].size_metrics"
          ]
        }
