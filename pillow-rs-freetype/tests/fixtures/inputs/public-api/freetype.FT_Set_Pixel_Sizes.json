    {
      "case_id": "freetype.FT_Set_Pixel_Sizes.error_invalid_or_unscalable_face",
      "subject": "freetype.FT_Set_Pixel_Sizes",
      "case": "error_invalid_or_unscalable_face",
      "operation": "freetype.set_pixel_sizes",
      "schema": "size_metrics",
      "expect_error": true,
      "inputs": {
        "assets": {
          "bitmap_font": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/bitmap/embedded-strike.ttf",
            "status": "required_future_asset",
            "requires": "Font with fixed bitmap strikes and observable available_sizes entries"
          },
          "malformed": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/malformed/not-a-font.bin",
            "status": "required_future_asset",
            "requires": "Small deterministic malformed byte blob rejected by C FreeType"
          }
        },
        "params": {
          "variants": [
            {
              "font": "bitmap_font",
              "pixel_width": 13,
              "pixel_height": 13
            },
            {
              "font": "malformed"
            },
            {
              "pixel_width": 65535,
              "pixel_height": 65535
            }
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "active_size_after_error": "c_oracle"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "outputs[*].status",
            "outputs[*].error",
            "outputs[*].size_snapshot_before_after"
          ]
        },
        "error": "c_oracle"
      }
    }
  ]
