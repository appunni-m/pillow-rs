  "cases": [
    {
      "case_id": "freetype.FT_Set_Pixel_Sizes.set_pixel_size",
      "subject": "freetype.FT_Set_Pixel_Sizes",
      "case": "set_pixel_size",
      "operation": "freetype.set_pixel_sizes",
      "schema": "size_metrics",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "sizes": [
            [
              0,
              12
            ],
            [
              12,
              0
            ],
            [
              12,
              18
            ],
            [
              20,
              20
            ]
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "size_metrics": "all public FT_Size_Metrics fields"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "outputs[*].status",
            "outputs[*].size_metrics"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Set_Pixel_Sizes.success_zero_dimension_normalization",
