{
  "version": 1,
  "subject": "freetype.FT_HAS_SVG",
  "manifest_cases": [
    "svg_table_face_returns_true",
    "no_svg_table_face_returns_false"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_HAS_SVG.svg_table_face_returns_true",
      "subject": "freetype.FT_HAS_SVG",
      "case": "svg_table_face_returns_true",
      "operation": "freetype.face_macro.has_svg",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "fonts/svg/color-svg-glyph.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_SVG",
          "post_probe": [
            "FT_Load_Glyph with FT_LOAD_SVG_ONLY"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_HAS_SVG",
          "expected_truth": true,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "OpenType font with 'SVG ' table"
        ]
      }
    },
    {
      "case_id": "freetype.FT_HAS_SVG.no_svg_table_face_returns_false",
      "subject": "freetype.FT_HAS_SVG",
      "case": "no_svg_table_face_returns_false",
      "operation": "freetype.face_macro.has_svg",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "input/fonts/LiberationSerif-Regular.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_SVG",
          "post_probe": [
            "FT_Load_Glyph with FT_LOAD_SVG_ONLY"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_HAS_SVG",
          "expected_truth": false,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
