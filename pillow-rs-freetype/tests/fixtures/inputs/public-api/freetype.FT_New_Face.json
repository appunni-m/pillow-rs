{
  "version": 1,
  "subject": "freetype.FT_New_Face",
  "manifest_cases": [
    "success_pathname_face",
    "success_negative_face_index_probe",
    "error_null_pathname",
    "error_null_library_or_aface",
    "error_missing_or_unknown_file"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_New_Face.success_pathname_face",
      "subject": "freetype.FT_New_Face",
      "case": "success_pathname_face",
      "operation": "freetype.new_face",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "post_open_probes": [
            "face_fields",
            "glyph_slot",
            "active_size",
            "selected_charmap"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "face": "created",
          "face_state": [
            "num_faces",
            "family_name",
            "style_name",
            "face_flags",
            "style_flags",
            "num_glyphs",
            "charmap_encoding",
            "glyph_slot_present",
            "size_present"
          ]
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "face_state"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_New_Face.success_negative_face_index_probe",
      "subject": "freetype.FT_New_Face",
      "case": "success_negative_face_index_probe",
      "operation": "freetype.new_face",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          },
          "variable_font": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/variable/named-instances.ttf",
            "status": "required_future_asset",
            "requires": "Variable font with at least one named instance"
          }
        },
        "params": {
          "face_index": -1,
          "probe_named_instances": true
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "face": "probe_only_or_released",
          "probe_fields": [
            "num_faces",
            "style_flags_named_instance_count"
          ]
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "probe_fields"
          ]
        },
        "fixture_requirements": [
          "Variable fixture required to prove named-instance count path"
        ]
      }
    },
    {
      "case_id": "freetype.FT_New_Face.error_null_pathname",
      "subject": "freetype.FT_New_Face",
      "case": "error_null_pathname",
      "operation": "freetype.new_face",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {},
        "params": {
          "library": "valid",
          "pathname": "null",
          "face_index": 0
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "aface": "unchanged"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "status",
            "error",
            "aface_nullness"
          ]
        },
        "error": "Invalid_Argument"
      }
    },
    {
      "case_id": "freetype.FT_New_Face.error_null_library_or_aface",
      "subject": "freetype.FT_New_Face",
      "case": "error_null_library_or_aface",
      "operation": "freetype.new_face",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "variants": [
            {
              "library": "null",
              "aface": "valid"
            },
            {
              "library": "valid",
              "aface": "null"
            }
          ],
          "face_index": 0
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "resource_cleanup": "no_leak"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "outputs[*].status",
            "outputs[*].error"
          ]
        },
        "error": "c_oracle"
      }
    },
    {
      "case_id": "freetype.FT_New_Face.error_missing_or_unknown_file",
      "subject": "freetype.FT_New_Face",
      "case": "error_missing_or_unknown_file",
      "operation": "freetype.new_face",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "variants": [
          {
            "id": "missing_path_face_index_0",
            "expect_error": true,
            "coverage": [
              "FT_New_Face reaches pinned C FT_OPEN_PATHNAME missing-file path at ftobjs.c:1604-1620 and ftsystem.c Cannot_Open_Resource"
            ],
            "assets": {
              "missing": {
                "kind": "ref",
                "role": "missing_path",
                "path": "input/fonts/missing/no-such.ttf"
              }
            },
            "params": {
              "face_index": 0
            }
          },
          {
            "id": "missing_path_face_index_9999",
            "expect_error": true,
            "coverage": [
              "FT_New_Face missing pathname fails during stream open before face-index validation, preserving Cannot_Open_Resource for an out-of-range face_index"
            ],
            "assets": {
              "missing": {
                "kind": "ref",
                "role": "missing_path",
                "path": "input/fonts/missing/no-such.ttf"
              }
            },
            "params": {
              "face_index": 9999
            }
          }
        ]
      },
      "classifiers": [
        "kind:function",
        "header:freetype"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "face": "not_created"
        },
        "compare": {
          "mode": "exact_error",
          "compare_error_output": true,
          "paths": [
            "outputs[*].status",
            "outputs[*].error",
            "outputs[*].face_nullness"
          ]
        },
        "error": "c_oracle"
      }
    }
  ]
}
