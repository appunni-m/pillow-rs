          },
          "no_cpal_font": {
            "kind": "ref",
            "role": "control_font",
            "id": "fonts/basic/dejavu-sans.ttf",
            "asset_kind": "font"
          }
        },
        "params": {
          "face_index": 0,
          "controls": [
            "valid CPAL face",
            "SFNT without CPAL",
            "null apalette",
            "null face if runner can safely probe"
          ],
          "sentinel_initialize_output": true,
          "read_name_ids": true,
          "read_palette_flags": true
        }
      },
      "classifiers": [
        "kind:record",
        "header:ftcolor",
        "area:cpal",
        "requires:font",
        "path:runtime"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "status": "FT_Error",
          "palette_data": {
            "num_palettes": "FT_UShort",
            "palette_name_ids": "array/null identity class",
            "palette_flags": "array/null identity class",
            "num_palette_entries": "FT_UShort",
            "palette_entry_name_ids": "array/null identity class"
          },
          "error": "FT_Err_Invalid_Argument for null output; ok with zero/null record for no CPAL face"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "error",
            "palette_data.num_palettes",
            "palette_data.palette_name_ids.nullness",
            "palette_data.palette_name_ids[]",
            "palette_data.palette_flags.nullness",
            "palette_data.palette_flags[]",
            "palette_data.num_palette_entries",
            "palette_data.palette_entry_name_ids.nullness",
            "palette_data.palette_entry_name_ids[]",
            "sentinel_preservation_on_error"
          ]
        },
        "fixture_requirements": [
          "CPAL fixture with multiple palettes, light/dark flags, palette labels, entry labels, and name-id 0xFFFF cases; control SFNT with no CPAL table."
        ]
      }
