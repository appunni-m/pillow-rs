  ],
  "cases": [
    {
      "case_id": "ftpfr.FT_Get_PFR_Kerning.pfr_pair_kerning_success",
      "subject": "ftpfr.FT_Get_PFR_Kerning",
      "case": "pfr_pair_kerning_success",
      "operation": "ftpfr.get_pfr_kerning",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/pfr/basic-kerning.pfr",
            "status": "required_future_asset",
            "requires": "PFR face with PFR_METRICS service and covered kerning pair"
          }
        },
        "params": {
          "face_index": 0,
          "pairs": [
            {
              "left": 1,
              "right": 2
            },
            {
              "left": 2,
              "right": 1
            }
          ],
          "avector_pointer_class": "valid",
          "abi": {
            "include": "<freetype/ftpfr.h>",
            "signature": "FT_Error FT_Get_PFR_Kerning(FT_Face face, FT_UInt left, FT_UInt right, FT_Vector* avector)"
          },
          "source_refs": [
            "freetype/include/freetype/ftpfr.h",
            "freetype/src/base/ftpfr.c"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftpfr",
        "area:pfr-metrics"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "avector": "FT_Vector in original PFR metrics units"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "return",
            "avector.x",
            "avector.y"
          ]
        },
        "fixture_requirements": [
          "Add a PFR kerning fixture; oracle output must be generated at runtime."
        ]
      }
    },
    {
      "case_id": "ftpfr.FT_Get_PFR_Kerning.non_pfr_falls_back_to_unscaled_kerning",
      "subject": "ftpfr.FT_Get_PFR_Kerning",
      "case": "non_pfr_falls_back_to_unscaled_kerning",
      "operation": "ftpfr.get_pfr_kerning",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          },
          "kern_font": {
            "kind": "ref",
            "role": "font",
            "id": "input/fonts/generated/kerning/legacy-av-kern.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "pairs": [
            "A/V",
            "glyph0/glyph0"
          ],
          "fallback_call": {
            "function": "FT_Get_Kerning",
            "mode": "FT_KERNING_UNSCALED"
          },
          "c_behavior": "ftpfr.c calls FT_Get_Kerning(face,left,right,FT_KERNING_UNSCALED,avector) when no PFR service exists"
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftpfr",
        "area:pfr-metrics",
        "area:kerning"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "avector": "FT_Vector from FT_Get_Kerning unscaled path",
          "fallback_return": "FT_Error"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "return",
            "avector.x",
            "avector.y",
            "fallback_return"
          ]
        },
        "fixture_requirements": [
          "Add a legacy kern non-PFR font to make the fallback nonzero."
        ]
      }
    },
    {
