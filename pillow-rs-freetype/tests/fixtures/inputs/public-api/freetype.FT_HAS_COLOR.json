{
  "version": 1,
  "subject": "freetype.FT_HAS_COLOR",
  "manifest_cases": [
    "face_flags_bit_probe",
    "color_font_semantics",
    "outline_control_false"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_HAS_COLOR.face_flags_bit_probe",
      "subject": "freetype.FT_HAS_COLOR",
      "case": "face_flags_bit_probe",
      "operation": "freetype.face_macro",
      "schema": "macro_probe",
      "expect_error": false,
      "inputs": {
        "assets": {},
        "params": {
          "flags": [
            0,
            "FT_FACE_FLAG_COLOR",
            "FT_FACE_FLAG_COLOR|FT_FACE_FLAG_SCALABLE"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face-flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "int-like boolean",
          "macro": "evaluated by C/Rust ABI probe"
        },
        "compare": {
          "mode": "value",
          "paths": [
            "outputs[*].macro_result",
            "outputs[*].face_flags"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_HAS_COLOR.color_font_semantics",
      "subject": "freetype.FT_HAS_COLOR",
      "case": "color_font_semantics",
      "operation": "freetype.face_macro",
      "schema": "macro_probe",
      "expect_error": false,
      "inputs": {
        "assets": {
          "colr": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/color/colr-cpal-layered.ttf",
            "status": "required_future_asset",
            "requires": "COLR/CPAL font with at least one layered color glyph"
          },
          "svg": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/svg/color-svg-glyph.ttf",
            "status": "required_future_asset",
            "requires": "OpenType SVG table fixture with a glyph renderable through FreeType's SVG path when enabled"
          },
          "bitmap_color": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/color/cbdt-cblc-color.ttf",
            "status": "required_future_asset",
            "requires": "CBDT/CBLC or sbix color bitmap font"
          }
        },
        "params": {
          "face_index": 0,
          "font_variants": [
            "COLR/CPAL",
            "CBDT/CBLC",
            "sbix",
            "SVG"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face-flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "int-like boolean",
          "macro": "evaluated by C/Rust ABI probe"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "outputs[*].macro_result",
            "outputs[*].face_flags",
            "outputs[*].color_probe"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_HAS_COLOR.outline_control_false",
      "subject": "freetype.FT_HAS_COLOR",
      "case": "outline_control_false",
      "operation": "freetype.face_macro",
      "schema": "macro_probe",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face-flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "int-like boolean",
          "macro": "evaluated by C/Rust ABI probe"
        },
        "compare": {
          "mode": "value",
          "paths": [
            "macro_result"
          ]
        }
      }
    }
  ]
