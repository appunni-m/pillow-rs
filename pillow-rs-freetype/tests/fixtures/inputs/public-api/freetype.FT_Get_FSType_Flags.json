{
  "version": 1,
  "subject": "freetype.FT_Get_FSType_Flags",
  "manifest_cases": [
    "sfnt_installable_embedding",
    "sfnt_restricted_embedding_bits",
    "null_or_missing_fstype_returns_c_value"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_Get_FSType_Flags.sfnt_installable_embedding",
      "subject": "freetype.FT_Get_FSType_Flags",
      "case": "sfnt_installable_embedding",
      "operation": "freetype.get_fstype_flags",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/fstype/installable-fstype.ttf",
            "status": "required_future_asset",
            "requires": "SFNT with OS/2 fsType equal to zero"
          }
        },
        "params": {
          "face_index": 0,
          "probe_table": "FT_SFNT_OS2"
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:embedding"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_UShort fsType"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "return"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Get_FSType_Flags.sfnt_restricted_embedding_bits",
      "subject": "freetype.FT_Get_FSType_Flags",
      "case": "sfnt_restricted_embedding_bits",
      "operation": "freetype.get_fstype_flags",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/fstype/restricted-no-subset.ttf",
            "status": "required_future_asset",
            "requires": "SFNT with nonzero OS/2 fsType bits for restricted embedding and no subsetting/bitmap-only as applicable"
          }
        },
        "params": {
          "face_index": 0,
          "probe_table": "FT_SFNT_OS2",
          "expected_bits": [
            "restricted",
            "no_subsetting",
            "bitmap_only_if_present"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:embedding"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_UShort fsType bitfield"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "return"
          ]
        }
      }
    },
    {
      "case_id": "freetype.FT_Get_FSType_Flags.null_or_missing_fstype_returns_c_value",
      "subject": "freetype.FT_Get_FSType_Flags",
      "case": "null_or_missing_fstype_returns_c_value",
      "operation": "freetype.get_fstype_flags",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font_without_os2": {
            "kind": "ref",
            "role": "font",
            "path": "fonts/type1/simple-type1.pfb",
            "requires": "Type 1 face with no PostScript FSType"
          }
        },
        "params": {
          "face_variants": [
            "null",
            "missing_fstype_data"
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:embedding"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_UShort"
        },
        "compare": {
          "mode": "value",
          "paths": [
            "return"
          ]
        }
      }
    }
  ]
}
