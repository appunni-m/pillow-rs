  "cases": [
    {
      "case_id": "ftcache.FTC_Manager_LookupFace.planned_cache_subsystem_not_out_of_scope",
      "subject": "ftcache.FTC_Manager_LookupFace",
      "case": "planned_cache_subsystem_not_out_of_scope",
      "operation": "ftcache.manager_lookup_face",
      "schema": "cache_operation",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "fonts/basic/dejavu-sans.ttf",
            "asset_kind": "font"
          },
          "alt_font": {
            "kind": "ref",
            "id": "fonts/basic/dejavu-serif.ttf",
            "asset_kind": "font"
          },
          "multi_charmap_font": {
            "kind": "ref",
            "id": "fonts/charmap/multiple-charmaps.ttf",
            "asset_kind": "font"
          }
        },
        "params": {
          "manager_limits": {
            "max_faces": 0,
            "max_sizes": 0,
            "max_bytes": 0
          },
          "face_ids": [
            "face-A",
            "face-B"
          ],
          "requester": "path_face_requester_with_log",
          "scenario": "planned_cache_subsystem_not_out_of_scope",
          "lookup_sequence": [
            "face-A",
            "face-A",
            "remove-face-A",
            "face-A"
          ],
          "requester_failure_face_id": "fail-with-invalid-file-format"
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftcache",
        "area:cache-subsystem"
      ],
      "expectation": {
        "status": "build_dependent",
        "output_shape": {
          "return": "FT_Error",
          "callback_log": true,
          "pointer_identity_classes": true,
          "cache_lifecycle": true,
          "face_public_fields": [
            "num_glyphs",
            "family_name",
            "style_name",
            "face_flags"
          ],
          "face_size_nullness": true
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "error",
            "outputs",
            "callback_log",
            "pointer_identity_classes",
            "lifecycle_events"
          ]
        },
        "fixture_requirements": [
          "Harness support for persistent FTC_FaceID callback data and requester invocation log"
        ]
      }
    },
