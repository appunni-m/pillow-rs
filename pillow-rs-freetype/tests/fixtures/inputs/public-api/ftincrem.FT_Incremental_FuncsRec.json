        "status": "build_dependent",
        "output_shape": {
          "load_error": "FT_Error",
          "callback_log": "array<callback_event>",
          "glyph_data": "FT_Data",
          "release_count": "usize"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "load_error",
            "callback_log",
            "release_count",
            "glyph_data.length"
          ]
        },
        "source_refs": [
          "freetype/src/truetype/ttgload.c"
        ],
        "fixture_requirements": [
          "fonts/incremental/minimal-glyf-incremental.ttf must exercise FT_CONFIG_OPTION_INCREMENTAL and load glyph bytes supplied by get_glyph_data.",
          "incremental/glyf/simple-and-composite-glyph-data.bin must contain raw glyf table bytes, referenced by glyph index, not embedded in this input JSON."
        ]
      }
