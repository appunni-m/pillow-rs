      "subject": "ftincrem.FT_Incremental_FuncsRec",
      "case": "glyph_data_success_and_release",
      "operation": "ftincrem.load_incremental_glyph",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "incremental_truetype_face": {
            "kind": "ref",
            "id": "fonts/incremental/minimal-glyf-incremental.ttf"
          },
          "glyph_data": {
            "kind": "ref",
            "id": "incremental/glyf/simple-and-composite-glyph-data.bin"
          }
        },
        "params": {
          "open_tag": "FT_PARAM_TAG_INCREMENTAL",
          "glyph_indices": [
            1,
            2
          ],
          "get_glyph_data_returns": "FT_Data pointer and length",
          "expect_free_glyph_data_after_success": true,
          "nested_composite_loads_allowed": true
        },
        "variability": {
          "axes": [
            "glyph_indices"
          ]
        }
      },
      "classifiers": [
        "kind:record",
        "runtime:incremental_callbacks",
        "source:ttgload"
      ],
