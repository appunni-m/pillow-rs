            "freetype/src/base/ftobjs.c",
            "freetype/src/smooth/ftsmooth.c",
            "freetype/src/raster/ftrend1.c"
          ],
          "c_behavior": "FT_Get_Renderer delegates to FT_Lookup_Renderer and returns the first renderer in library->renderers with matching glyph_format"
