{
  "version": 1,
  "subject": "freetype.FT_IS_CID_KEYED",
  "manifest_cases": [
    "exposed_cid_keyed_face_returns_true",
    "sfnt_wrapped_or_non_cid_face_returns_false"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_IS_CID_KEYED.exposed_cid_keyed_face_returns_true",
      "subject": "freetype.FT_IS_CID_KEYED",
      "case": "exposed_cid_keyed_face_returns_true",
      "operation": "freetype.face_macro.is_cid_keyed",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "fonts/cid/cid-keyed-type1.otf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_CID_KEYED",
          "post_probe": [
            "FT_Get_CID_Registry_Ordering_Supplement"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_IS_CID_KEYED",
          "expected_truth": true,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "non-SFNT CID-keyed Type 1 or CFF face exposed through FT_FACE_FLAG_CID_KEYED"
        ]
      }
    },
    {
