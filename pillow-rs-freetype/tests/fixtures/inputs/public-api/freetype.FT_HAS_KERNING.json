{
  "version": 1,
  "subject": "freetype.FT_HAS_KERNING",
  "manifest_cases": [
    "kerning_face_returns_true",
    "non_kerning_face_returns_false"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_HAS_KERNING.kerning_face_returns_true",
      "subject": "freetype.FT_HAS_KERNING",
      "case": "kerning_face_returns_true",
      "operation": "freetype.face_macro.has_kerning",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "fonts/kerning/kern-pair-av.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_KERNING",
          "post_probe": [
            "FT_Get_Kerning(A,V,FT_KERNING_DEFAULT)"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_HAS_KERNING",
          "expected_truth": true,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "font with legacy kern table or C-supported basic GPOS pair kerning"
        ]
      }
    },
    {
      "case_id": "freetype.FT_HAS_KERNING.non_kerning_face_returns_false",
      "subject": "freetype.FT_HAS_KERNING",
      "case": "non_kerning_face_returns_false",
      "operation": "freetype.face_macro.has_kerning",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "fonts/control/no-kerning.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_KERNING",
          "post_probe": [
            "FT_Get_Kerning(A,V,FT_KERNING_DEFAULT)"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_HAS_KERNING",
          "expected_truth": false,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "comparable outline font with no C-supported kerning"
        ]
      }
    }
  ]
}
