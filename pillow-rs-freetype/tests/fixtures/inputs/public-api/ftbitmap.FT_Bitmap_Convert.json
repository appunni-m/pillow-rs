      "case": "success_supported_depths_to_gray",
      "operation": "ftbitmap.bitmap_convert",
      "schema": "bitmap_operation",
      "expect_error": false,
      "inputs": {
        "assets": {
          "synthetic_bitmaps": {
            "kind": "ref",
            "id": "bitmaps/synthetic/public-bitmap-matrix.bin",
            "asset_kind": "binary"
          },
          "font": {
            "kind": "ref",
            "id": "fonts/basic/dejavu-sans.ttf",
            "asset_kind": "font"
          }
        },
        "params": {
          "scenario": "success_supported_depths_to_gray",
          "pixel_modes": [
            "MONO",
            "GRAY2",
            "GRAY4",
            "GRAY",
            "LCD",
            "LCD_V",
            "BGRA",
            "NONE"
          ],
          "alignments": [
            1,
            2,
            4,
            0,
            3
          ],
          "target_initial_pitch": [
            0,
            -1,
            1
          ]
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftbitmap",
        "area:bitmap"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "bitmap_fields": [
            "rows",
            "width",
            "pitch",
            "pixel_mode",
            "num_grays",
            "buffer"
          ],
          "buffer_bytes": true,
          "allocator_events": true,
          "target_pixel_mode": "GRAY",
          "alignment_policy": true
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "error",
            "target.rows",
            "target.width",
            "target.pitch",
            "target.num_grays",
            "target.pixel_mode",
            "target.buffer_bytes",
            "allocator.events"
          ]
        }
      }
