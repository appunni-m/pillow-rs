{
  "version": 1,
  "subject": "freetype.FT_GlyphSlot",
  "manifest_cases": [
    "populated_from_load",
    "overwritten_by_subsequent_load",
    "render_mutates_slot"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_GlyphSlot.populated_from_load",
      "subject": "freetype.FT_GlyphSlot",
      "case": "populated_from_load",
      "operation": "freetype.load_glyph",
      "schema": "glyph_slot",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "pixel_size": 20,
          "glyph_indices": [
            36,
            57
          ],
          "load_flag_sets": [
            [
              "FT_LOAD_DEFAULT"
            ],
            [
              "FT_LOAD_NO_HINTING"
            ],
            [
              "FT_LOAD_NO_SCALE"
            ]
          ]
        },
        "variability": {
          "axes": [
            "glyph_indices",
            "load_flags"
          ]
        }
      },
      "classifiers": [
        "kind:type",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "status": "FT_Error",
          "slot": "FT_GlyphSlotRec public view"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "slot.glyph_index",
            "slot.metrics",
            "slot.linearHoriAdvance",
            "slot.linearVertAdvance",
            "slot.advance",
            "slot.format",
            "slot.bitmap_left",
            "slot.bitmap_top",
            "slot.outline.n_points",
            "slot.outline.n_contours",
            "slot.lsb_delta",
            "slot.rsb_delta"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/freetype.h",
          "freetype/src/base/ftobjs.c"
        ]
      }
    },
    {
      "case_id": "freetype.FT_GlyphSlot.overwritten_by_subsequent_load",
      "subject": "freetype.FT_GlyphSlot",
      "case": "overwritten_by_subsequent_load",
      "operation": "freetype.glyph_slot_reuse",
      "schema": "glyph_slot",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "pixel_size": 20,
          "load_sequence": [
            36,
            57,
            36
          ],
          "load_flags": [
            "FT_LOAD_DEFAULT"
          ],
          "identity_policy": "same face-owned slot object, changing contents"
        }
      },
      "classifiers": [
        "kind:type",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "status": "FT_Error",
          "slot_identity": "same",
          "snapshots": "array"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "snapshots[*].status",
            "slot_identity",
            "snapshots[*].glyph_index",
            "snapshots[*].metrics",
            "snapshots[*].format",
            "snapshots[*].outline_hash"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/freetype.h",
          "freetype/src/base/ftobjs.c"
        ]
      }
    },
    {
      "case_id": "freetype.FT_GlyphSlot.render_mutates_slot",
      "subject": "freetype.FT_GlyphSlot",
      "case": "render_mutates_slot",
      "operation": "freetype.render_glyph",
      "schema": "glyph_slot",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "file",
            "role": "font",
            "path": "input/fonts/DejaVuSans.ttf"
          }
        },
        "params": {
          "face_index": 0,
          "pixel_size": 20,
          "glyph_index": 36,
          "load_flags": [
            "FT_LOAD_DEFAULT"
          ],
          "render_modes": [
            "FT_RENDER_MODE_NORMAL",
            "FT_RENDER_MODE_MONO",
            "FT_RENDER_MODE_LCD"
          ]
        },
        "variability": {
          "axes": [
            "render_modes"
          ]
        }
      },
      "classifiers": [
        "kind:type",
        "header:freetype"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "status": "FT_Error",
          "before": "outline slot",
          "after": "bitmap slot",
          "bitmap": "bytes"
        },
        "compare": {
          "mode": "bytes",
          "paths": [
            "load.status",
            "render.status",
            "before.format",
            "after.format",
            "after.bitmap.pixel_mode",
            "after.bitmap.rows",
            "after.bitmap.width",
            "after.bitmap.pitch",
            "after.bitmap.buffer",
            "after.bitmap_left",
            "after.bitmap_top",
            "after.advance"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/freetype.h",
          "freetype/src/base/ftobjs.c"
        ]
      }
    }
  ]
}
