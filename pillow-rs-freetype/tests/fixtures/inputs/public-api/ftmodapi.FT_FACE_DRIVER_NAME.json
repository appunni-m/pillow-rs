{
  "version": 1,
  "subject": "ftmodapi.FT_FACE_DRIVER_NAME",
  "manifest_cases": [
    "returns_driver_module_name",
    "driver_name_not_font_format"
  ],
  "cases": [
    {
      "case_id": "ftmodapi.FT_FACE_DRIVER_NAME.returns_driver_module_name",
      "subject": "ftmodapi.FT_FACE_DRIVER_NAME",
      "case": "returns_driver_module_name",
      "operation": "ftmodapi.face_driver_name",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "id": "input/fonts/DejaVuSans.ttf",
            "requirements": "Existing TrueType font opened through the default TrueType driver."
          }
        },
        "params": {
          "library": "new_from_FT_Init_FreeType",
          "face_index": 0,
          "macro": "FT_FACE_DRIVER_NAME(face)",
          "expected_driver_family": "truetype"
        }
      },
      "classifiers": [
        "kind:macro",
        "header:ftmodapi",
        "area:face",
        "area:driver",
        "requires:font"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "driver_name": "const FT_String*",
          "string_bytes": "bytes",
          "nul_terminated": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "driver_name",
            "string_bytes",
            "nul_terminated"
          ]
        },
        "source_refs": [
          "freetype/include/freetype/ftmodapi.h:FT_FACE_DRIVER_NAME"
        ]
      }
    },
    {
      "case_id": "ftmodapi.FT_FACE_DRIVER_NAME.driver_name_not_font_format",
      "subject": "ftmodapi.FT_FACE_DRIVER_NAME",
      "case": "driver_name_not_font_format",
      "operation": "ftmodapi.face_driver_name_with_font_format",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "truetype_font": {
            "kind": "ref",
            "role": "font",
            "id": "input/fonts/DejaVuSans.ttf"
          },
          "cff_or_type1_font": {
            "kind": "ref",
            "role": "font",
            "id": "future/fonts/cff_or_type1_outline_font.otf",
            "requirements": "Future shared asset representing a non-TrueType outline driver so driver_name and font_format are not inferred from one another."
          }
        },
        "params": {
          "compare_with": "FT_Get_Font_Format",
          "driver_name_source": "(*((FT_Module_Class**)face->driver))->module_name"
        }
      },
      "classifiers": [
        "kind:macro",
        "header:ftmodapi",
        "area:face",
        "area:driver",
        "requires:font"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "driver_name": "string",
          "font_format": "string",
          "same_source": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "driver_name",
            "font_format",
            "same_source"
          ]
        },
        "fixture_requirements": [
          "add a shared CFF or Type1 outline font asset before broadening this macro beyond the existing TrueType asset"
        ],
        "source_refs": [
          "freetype/include/freetype/ftmodapi.h:FT_FACE_DRIVER_NAME",
          "freetype/src/base/ftfntfmt.c:FT_Get_Font_Format"
        ]
      }
    }
  ]
}
