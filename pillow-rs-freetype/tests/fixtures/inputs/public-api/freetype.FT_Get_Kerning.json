      "operation": "freetype.get_kerning",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "role": "font",
            "path": "input/fonts/kerning/legacy-av-kern.ttf",
            "status": "required_future_asset",
            "requires": "SFNT with legacy kern table containing A/V pair and no GPOS-only ambiguity"
          }
        },
        "params": {
          "face_index": 0,
          "size_ppem_values": [
            9,
            20,
            32
          ],
          "left_glyph_name": "A",
          "right_glyph_name": "V",
          "kern_mode": "FT_KERNING_DEFAULT"
        }
      },
      "classifiers": [
        "kind:function",
        "header:freetype",
        "area:kerning"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "akerning": "FT_Vector 26.6 grid-fitted"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "status",
            "akerning.x",
            "akerning.y"
          ]
        }
      }
