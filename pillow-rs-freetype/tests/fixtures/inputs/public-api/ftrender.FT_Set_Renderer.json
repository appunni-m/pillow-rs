        "params": {
          "variants": [
            {
              "library": "NULL",
              "renderer": "NULL",
              "num_params": 0,
              "parameters": "NULL",
              "expected_error": "Invalid_Library_Handle"
            },
            {
              "library": "initialized",
              "renderer": "NULL",
              "num_params": 0,
              "parameters": "NULL",
              "expected_error": "Invalid_Argument"
            },
            {
              "library": "initialized",
              "renderer": "foreign_or_freed_renderer_token",
              "num_params": 0,
              "parameters": "NULL",
              "expected_error": "Invalid_Argument"
            },
            {
              "library": "initialized",
              "renderer": "library_owned_outline_renderer",
              "num_params": 1,
              "parameters": "NULL",
              "expected_error": "Invalid_Argument"
            }
          ],
          "c_behavior": "Validation order is library, renderer, parameters, then FT_List_Find membership"
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftrender",
        "area:renderer-management"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
