    {
      "case_id": "ftrender.FT_Set_Renderer.set_mode_parameter_error_propagates",
      "subject": "ftrender.FT_Set_Renderer",
      "case": "set_mode_parameter_error_propagates",
      "operation": "ftrender.set_renderer",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {
          "test_renderer_module": {
            "kind": "ref",
            "role": "renderer_module_probe",
            "path": "input/abi-probes/ftrender/custom-set-mode-renderer.c",
            "status": "required_future_asset",
            "requires": "Test renderer module with set_mode callback that logs tags and returns a configurable FT_Error"
          }
        },
        "params": {
          "library": "initialized_with_test_renderer",
          "renderer": "test_renderer",
          "parameters": [
            {
              "tag": "FT_MAKE_TAG('o','k','0','1')",
              "data": "opaque_token_ok"
            },
            {
              "tag": "FT_MAKE_TAG('e','r','r','!')",
              "data": "opaque_token_error",
              "callback_error": "Invalid_Argument"
            },
            {
              "tag": "FT_MAKE_TAG('s','k','i','p')",
              "data": "must_not_be_seen"
            }
          ],
          "c_behavior": "C moves renderer to front and sets cur_renderer before calling set_mode in order, then returns first nonzero error"
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftrender",
        "area:renderer-management"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "set_mode_event_log": "ordered array",
          "current_renderer_identity": "test_renderer",
          "renderer_list_order": "test_renderer_first"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "return",
            "set_mode_event_log",
            "current_renderer_identity",
            "renderer_list_order"
          ]
        },
        "error": "Invalid_Argument",
        "fixture_requirements": [
          "Add custom renderer module probe to observe set_mode order and error propagation."
        ]
      }
    },
