    {
      "case_id": "ftrender.FT_Set_Renderer.set_outline_renderer_success",
      "subject": "ftrender.FT_Set_Renderer",
      "case": "set_outline_renderer_success",
      "operation": "ftrender.set_renderer",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {},
        "params": {
          "library": "initialized",
          "renderer_source": {
            "function": "FT_Get_Renderer",
            "format": "FT_GLYPH_FORMAT_OUTLINE"
          },
          "num_params": 0,
          "parameters": "NULL",
          "abi": {
            "include": "<freetype/ftrender.h>",
            "signature": "FT_Error FT_Set_Renderer(FT_Library library, FT_Renderer renderer, FT_UInt num_params, FT_Parameter* parameters)"
          },
          "source_refs": [
            "freetype/include/freetype/ftrender.h",
            "freetype/src/base/ftobjs.c"
          ],
          "c_behavior": "FT_List_Up moves the renderer node to the front; outline renderers also become library->cur_renderer"
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftrender",
        "area:renderer-management"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "return": "FT_Error",
          "current_renderer_identity": "opaque pointer token",
          "renderer_list_order": "identity tokens"
        },
        "compare": {
          "mode": "identity_class",
          "paths": [
            "return",
            "current_renderer_identity",
            "renderer_list_order"
          ]
        }
      }
    },
    {
      "case_id": "ftrender.FT_Set_Renderer.invalid_library_renderer_or_params",
      "subject": "ftrender.FT_Set_Renderer",
      "case": "invalid_library_renderer_or_params",
      "operation": "ftrender.set_renderer",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {},
        "params": {
          "variants": [
            {
              "library": "NULL",
              "renderer": "NULL",
              "num_params": 0,
              "parameters": "NULL",
              "expected_error": "Invalid_Library_Handle"
            },
            {
              "library": "initialized",
              "renderer": "NULL",
              "num_params": 0,
              "parameters": "NULL",
              "expected_error": "Invalid_Argument"
            },
            {
              "library": "initialized",
              "renderer": "foreign_or_freed_renderer_token",
              "num_params": 0,
              "parameters": "NULL",
              "expected_error": "Invalid_Argument"
            },
            {
              "library": "initialized",
              "renderer": "library_owned_outline_renderer",
              "num_params": 1,
              "parameters": "NULL",
              "expected_error": "Invalid_Argument"
            }
          ],
          "c_behavior": "Validation order is library, renderer, parameters, then FT_List_Find membership"
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftrender",
        "area:renderer-management"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "renderer_list_order": "unchanged for validation failures before FT_List_Up"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "return",
            "renderer_list_order"
          ]
        },
        "error": "variant_expected_error"
      }
    },
    {
      "case_id": "ftrender.FT_Set_Renderer.set_mode_parameter_error_propagates",
      "subject": "ftrender.FT_Set_Renderer",
      "case": "set_mode_parameter_error_propagates",
      "operation": "ftrender.set_renderer",
      "schema": "api_result",
      "expect_error": true,
      "inputs": {
        "assets": {
          "test_renderer_module": {
            "kind": "ref",
            "role": "renderer_module_probe",
            "path": "input/abi-probes/ftrender/custom-set-mode-renderer.c",
            "status": "required_future_asset",
            "requires": "Test renderer module with set_mode callback that logs tags and returns a configurable FT_Error"
          }
        },
        "params": {
          "library": "initialized_with_test_renderer",
          "renderer": "test_renderer",
          "parameters": [
            {
              "tag": "FT_MAKE_TAG('o','k','0','1')",
              "data": "opaque_token_ok"
            },
            {
              "tag": "FT_MAKE_TAG('e','r','r','!')",
              "data": "opaque_token_error",
              "callback_error": "Invalid_Argument"
            },
            {
              "tag": "FT_MAKE_TAG('s','k','i','p')",
              "data": "must_not_be_seen"
            }
          ],
          "c_behavior": "C moves renderer to front and sets cur_renderer before calling set_mode in order, then returns first nonzero error"
        }
      },
      "classifiers": [
        "kind:function",
        "header:ftrender",
        "area:renderer-management"
      ],
      "expectation": {
        "status": "error",
        "output_shape": {
          "return": "FT_Error",
          "set_mode_event_log": "ordered array",
          "current_renderer_identity": "test_renderer",
          "renderer_list_order": "test_renderer_first"
        },
        "compare": {
          "mode": "exact_error",
          "paths": [
            "return",
            "set_mode_event_log",
            "current_renderer_identity",
            "renderer_list_order"
          ]
        },
        "error": "Invalid_Argument",
        "fixture_requirements": [
          "Add custom renderer module probe to observe set_mode order and error propagation."
        ]
      }
    },
