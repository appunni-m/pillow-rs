      "case": "value_matches_header",
      "operation": "constant",
      "schema": "api_constant",
      "expect_error": false,
      "inputs": {
        "assets": {},
        "params": {
          "symbol": "FT_LOAD_SBITS_ONLY",
          "include": "<freetype/freetype.h>",
