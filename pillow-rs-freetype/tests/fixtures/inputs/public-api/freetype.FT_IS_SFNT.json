{
  "version": 1,
  "subject": "freetype.FT_IS_SFNT",
  "manifest_cases": [
    "sfnt_face_returns_true",
    "non_sfnt_face_returns_false"
  ],
  "cases": [
    {
      "case_id": "freetype.FT_IS_SFNT.sfnt_face_returns_true",
      "subject": "freetype.FT_IS_SFNT",
      "case": "sfnt_face_returns_true",
      "operation": "freetype.face_macro.is_sfnt",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "input/fonts/LiberationSerif-Regular.ttf"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_SFNT",
          "post_probe": [
            "FT_Get_Sfnt_Name_Count",
            "FT_Get_Sfnt_Table"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_IS_SFNT",
          "expected_truth": true,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "TrueType/OpenType SFNT font"
        ]
      }
    },
    {
      "case_id": "freetype.FT_IS_SFNT.non_sfnt_face_returns_false",
      "subject": "freetype.FT_IS_SFNT",
      "case": "non_sfnt_face_returns_false",
      "operation": "freetype.face_macro.is_sfnt",
      "schema": "api_result",
      "expect_error": false,
      "inputs": {
        "assets": {
          "font": {
            "kind": "ref",
            "id": "fonts/type1/simple-type1.pfb"
          }
        },
        "params": {
          "open": "FT_New_Memory_Face",
          "face_index": 0,
          "flag_or_expression": "FT_FACE_FLAG_SFNT",
          "post_probe": [
            "FT_Get_Sfnt_Name_Count",
            "FT_Get_Sfnt_Table"
          ],
          "include": "freetype/freetype.h",
          "macro": "FT_IS_SFNT",
          "expected_truth": false,
          "probe": [
            "macro_result",
            "face.face_flags",
            "face.face_index"
          ]
        }
      },
      "classifiers": [
        "kind:macro",
        "header:freetype",
        "area:face_property_macro",
        "runtime:face_flags"
      ],
      "expectation": {
        "status": "ok",
        "output_shape": {
          "macro_result": "FT_Bool-compatible int",
          "face_flags": "FT_Long",
          "face_index": "FT_Long",
          "import_compiles": "bool"
        },
        "compare": {
          "mode": "exact",
          "paths": [
            "macro_result",
            "face_flags",
            "face_index",
            "import_compiles"
          ]
        },
        "fixture_requirements": [
          "non-SFNT Type1/CFF/BDF/PCF control font"
        ]
      }
    }
  ]
}
