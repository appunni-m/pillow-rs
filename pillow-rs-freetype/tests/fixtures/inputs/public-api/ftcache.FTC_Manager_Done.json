          }
        },
        "params": {
          "manager_limits": {
            "max_faces": 0,
            "max_sizes": 0,
            "max_bytes": 0
          },
          "face_ids": [
            "face-A",
            "face-B"
          ],
          "requester": "path_face_requester_with_log",
          "scenario": "planned_cache_subsystem_not_out_of_scope",
          "populate": [
