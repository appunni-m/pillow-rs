{
  "format_version": 2,
  "pillow_version": "12.2.0",
  "freetype_version": "2.14.3",
  "suite": 0,
  "operation": {
    "module": "ImageFont",
    "class": "TransposedFont",
    "target": "getlength"
  },
  "cases": [
    {
      "id": "transposed_getlength_unrotated",
      "assert": {
        "method": "typed",
        "value": {
          "type": "float",
          "hex": "0x1.2000000000000p+6"
        }
      }
    },
    {
      "id": "transposed_getlength_rotate_90",
      "assert": {
        "method": "error",
        "exception": "ValueError",
        "message": "text length is undefined for text rotated by 90 or 270 degrees"
      }
    }
  ]
}