{
  "format_version": 2,
  "pillow_version": "12.2.0",
  "freetype_version": "2.14.3",
  "suite": 1,
  "operation": {
    "module": "Image",
    "target": "filter"
  },
  "cases": [
    {
      "id": "Image.filter_1_suite1",
      "assert": {
        "method": "image",
        "reference": "images/Image.filter_Image.filter_1_suite1.png"
      }
    },
    {
      "id": "Image.filter_CMYK_suite1",
      "assert": {
        "method": "image",
        "reference": "raws/Image.filter_Image.filter_CMYK_suite1.bin",
        "raw_kind": "image",
        "mode": "CMYK",
        "size": [
          200,
          50
        ]
      }
    },
    {
      "id": "Image.filter_L_suite1",
      "assert": {
        "method": "image",
        "reference": "images/Image.filter_Image.filter_L_suite1.png"
      }
    },
    {
      "id": "Image.filter_LA_suite1",
      "assert": {
        "method": "image",
        "reference": "images/Image.filter_Image.filter_LA_suite1.png"
      }
    },
    {
      "id": "Image.filter_P_suite1",
      "assert": {
        "method": "error",
        "exception": "ValueError",
        "message": "cannot filter palette images"
      }
    },
    {
      "id": "Image.filter_RGBA_suite1",
      "assert": {
        "method": "image",
        "reference": "images/Image.filter_Image.filter_RGBA_suite1.png"
      }
    },
    {
      "id": "blur_rgb_suite1",
      "assert": {
        "method": "image",
        "reference": "images/Image.filter_blur_rgb_suite1.png"
      }
    },
    {
      "id": "contour_rgb_suite1",
      "assert": {
        "method": "image",
        "reference": "images/Image.filter_contour_rgb_suite1.png"
      }
    },
    {
      "id": "gaussian_blur_rgb_suite1",
      "assert": {
        "method": "image",
        "reference": "images/Image.filter_gaussian_blur_rgb_suite1.png"
      }
    }
  ]
}