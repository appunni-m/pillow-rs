{
  "format_version": 2,
  "suite": 0,
  "operation": {
    "module": "ImageOps",
    "target": "autocontrast"
  },
  "cases": [
    {
      "id": "ImageOps.autocontrast_LA",
      "assert": {
        "method": "error",
        "exception": "OSError",
        "message_contains": "not supported for mode LA"
      }
    },
    {
      "id": "ImageOps.autocontrast_RGBA",
      "assert": {
        "method": "error",
        "exception": "OSError",
        "message_contains": "not supported for mode RGBA"
      }
    },
    {
      "id": "ImageOps_autocontrast_L",
      "assert": {
        "method": "image",
        "reference": "images/ImageOps.autocontrast_ImageOps_autocontrast_L.png"
      }
    },
    {
      "id": "ImageOps_autocontrast_RGB",
      "assert": {
        "method": "image",
        "reference": "images/ImageOps.autocontrast_ImageOps_autocontrast_RGB.png"
      }
    }
  ]
}