      "assert": {
        "method": "string",
        "value": "(255, 255, 255)",
        "prefix": ""
      }
    },
    {
      "id": "Image_getpixel_RGBA",
      "assert": {
        "method": "string",
        "value": "(255, 255, 255, 255)",
        "prefix": ""
      }
