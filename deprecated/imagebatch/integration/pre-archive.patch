+/// Restrict an explicit GPU pipeline job, including its auxiliary pipelines,
+/// to device implementations. Restore the caller's policy on errors and unwind.
+pub(crate) fn with_native_gpu_execution<T>(
+    execute: impl FnOnce() -> Result<T, PilError>,
+) -> Result<T, PilError> {
+    struct RestorePolicy(bool);
+    impl Drop for RestorePolicy {
+        fn drop(&mut self) {
+            NATIVE_GPU_EXECUTION_REQUIRED.with(|policy| policy.set(self.0));
+        }
+    }
+    let _restore = RestorePolicy(NATIVE_GPU_EXECUTION_REQUIRED.with(|policy| policy.replace(true)));
+    execute()
+}
+
+pub(crate) fn gpu_native_execution_required() -> bool {
+    NATIVE_GPU_EXECUTION_REQUIRED.with(Cell::get)
+}
